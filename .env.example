# =============================================================================
# BrandPulse Organic & GEO Studio — variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA commitar `.env.local`.
# Chaves ficam apenas no servidor, exceto as explicitamente prefixadas com
# NEXT_PUBLIC_ (que são públicas por definição).
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Projeto: https://supabase.com/dashboard  (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Postgres (Project Settings > Database > Connection string > URI).
# Usada por: PostgresSaver (LangGraph), pgmq (filas) e RPCs transacionais.
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Bucket privado onde os ativos renderizados são gravados (URLs assinadas).
SUPABASE_STORAGE_BUCKET=brand-assets

# --- Provedores LLM ----------------------------------------------------------
# LLM_PROVIDER_MODE=mock roda o pipeline inteiro sem rede (dev/testes/CI).
# LLM_PROVIDER_MODE=live exige as chaves abaixo.
LLM_PROVIDER_MODE=mock
ANTHROPIC_API_KEY=
# DeepSeek: usado como modelo de texto (opção mais econômica).
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Roteamento de modelos (economia + qualidade). Troque só se souber o impacto.
MODEL_ROUTER=deepseek:deepseek-chat
MODEL_QUALITY=deepseek:deepseek-chat
MODEL_GUARDRAIL=deepseek:deepseek-chat
MODEL_EMBEDDING=google:gemini-embedding-2
# Dimensão fixa do vetor (<= 2000) compatível com índice HNSW.
EMBEDDING_DIMENSION=768

# --- Busca orgânica (SERP) ---------------------------------------------------
# SERP_PROVIDER: serper | gemini_grounding | mock
SERP_PROVIDER=mock
SERPER_API_KEY=

# --- Imagens IA opcionais ----------------------------------------------------
# IMAGE_PROVIDER: none | google_nano_banana | seedream | mock
IMAGE_PROVIDER=none
IMAGE_PROVIDER_API_KEY=

# --- Mercado Pago (Brasil) ---------------------------------------------------
# Access Token de produção/sandbox fica SOMENTE no servidor.
MP_ACCESS_TOKEN=
MP_ENVIRONMENT=sandbox
# Chave pública do Payment Brick (é pública por design, mas não é segredo).
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Secret do webhook para validar x-signature (HMAC-SHA256).
MP_WEBHOOK_SECRET=
# IDs de preapproval_plan por plano (criados no painel do Mercado Pago).
MP_PLAN_ESSENTIAL=
MP_PLAN_PRO=
MP_PLAN_AGENCY=

# --- Observabilidade ---------------------------------------------------------
LOG_LEVEL=info
